{
  "openapi": "3.0.3",
  "info": {
    "title": "优惠券秒杀接口",
    "description": "景点运营者管理满减券秒杀活动，以及游客异步抢券、查询结果和查看本人优惠券的 MVP 接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "OperatorCoupon",
      "description": "运营端优惠券活动管理"
    },
    {
      "name": "CatalogCoupon",
      "description": "游客端公开活动查询"
    },
    {
      "name": "TouristCoupon",
      "description": "游客抢券和本人优惠券查询"
    }
  ],
  "paths": {
    "/operator/coupon-activities": {
      "get": {
        "tags": ["OperatorCoupon"],
        "summary": "分页查询优惠券活动",
        "description": "分页查询当前运营者所属景点的活动，可按状态和名称筛选。",
        "operationId": "pageCouponActivities",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Page"},
          {"$ref": "#/components/parameters/Size"},
          {"$ref": "#/components/parameters/ActivityStatusQuery"},
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "maxLength": 50},
            "description": "活动名称关键字"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CouponActivityPageApiResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "tags": ["OperatorCoupon"],
        "summary": "创建优惠券活动草稿",
        "description": "在当前运营者所属景点创建 DRAFT 状态的满减券活动。",
        "operationId": "createCouponActivity",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CouponActivityWriteRequest"},
              "example": {
                "name": "暑期满100减20券",
                "thresholdAmount": 100.00,
                "discountAmount": 20.00,
                "totalStock": 500,
                "claimStartAt": "2026-08-10T10:00:00",
                "claimEndAt": "2026-08-10T12:00:00",
                "validFrom": "2026-08-10T10:00:00",
                "validUntil": "2026-08-31T23:59:59"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CouponActivityCreatedApiResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/operator/coupon-activities/{activityId}": {
      "get": {
        "tags": ["OperatorCoupon"],
        "summary": "获取优惠券活动详情",
        "description": "获取当前景点指定活动的完整规则和库存信息。",
        "operationId": "getCouponActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ActivityId"}],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CouponActivityDetailApiResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ActivityNotFound"}
        }
      },
      "put": {
        "tags": ["OperatorCoupon"],
        "summary": "修改优惠券活动草稿",
        "description": "仅允许修改当前景点中处于 DRAFT 状态的活动。",
        "operationId": "updateCouponActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ActivityId"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CouponActivityWriteRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/OperationSucceeded"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ActivityNotFound"},
          "409": {"$ref": "#/components/responses/ActivityConflict"}
        }
      }
    },
    "/operator/coupon-activities/{activityId}/publish": {
      "post": {
        "tags": ["OperatorCoupon"],
        "summary": "发布优惠券活动",
        "description": "将 DRAFT 活动发布为 PUBLISHED。发布后 cacheReady 仍为 false，由开抢前自动预热链路初始化 Redis。",
        "operationId": "publishCouponActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ActivityId"}],
        "responses": {
          "200": {"$ref": "#/components/responses/OperationSucceeded"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ActivityNotFound"},
          "409": {"$ref": "#/components/responses/ActivityConflict"}
        }
      }
    },
    "/operator/coupon-activities/{activityId}/cancel": {
      "post": {
        "tags": ["OperatorCoupon"],
        "summary": "取消优惠券活动",
        "description": "取消 DRAFT 或 PUBLISHED 活动；已经发放的游客优惠券继续有效。",
        "operationId": "cancelCouponActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ActivityId"}],
        "responses": {
          "200": {"$ref": "#/components/responses/OperationSucceeded"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ActivityNotFound"},
          "409": {"$ref": "#/components/responses/ActivityConflict"}
        }
      }
    },
    "/public/venues/{venueId}/coupon-activities": {
      "get": {
        "tags": ["CatalogCoupon"],
        "summary": "查询景点可领取优惠券活动",
        "description": "公开查询指定景点已发布且尚未结束的优惠券活动。",
        "operationId": "listClaimableCouponActivities",
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/VenueId"}],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CatalogCouponActivityListApiResponse"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/VenueNotFound"}
        }
      }
    },
    "/tourist/coupon-activities/{activityId}/claims": {
      "post": {
        "tags": ["TouristCoupon"],
        "summary": "异步提交抢券请求",
        "description": "通过 Redis 原子预扣库存并向 Kafka 投递请求。202 仅代表请求被受理，不代表已经领取成功。重复提交返回原请求号。",
        "operationId": "claimCoupon",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/ActivityId"}],
        "responses": {
          "202": {
            "description": "首次请求已进入异步处理",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ClaimAcceptedApiResponse"}
              }
            }
          },
          "200": {
            "description": "重复提交，返回原请求的当前结果",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ClaimResultApiResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ActivityNotFound"},
          "409": {"$ref": "#/components/responses/ClaimConflict"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/tourist/coupon-claims/{requestId}": {
      "get": {
        "tags": ["TouristCoupon"],
        "summary": "查询抢券结果",
        "description": "查询当前游客自己的异步抢券请求，最终结果以数据库记录为准。",
        "operationId": "getCouponClaimResult",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/RequestId"}],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ClaimResultApiResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ClaimRequestNotFound"}
        }
      }
    },
    "/tourist/coupons": {
      "get": {
        "tags": ["TouristCoupon"],
        "summary": "查询我的优惠券",
        "description": "查询当前游客领取的优惠券，可筛选景点、状态和可满足的订单金额。MVP 阶段不分页。",
        "operationId": "listMyCoupons",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "venueId",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "format": "int64", "minimum": 1}
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {"$ref": "#/components/schemas/UserCouponStatus"}
          },
          {
            "name": "orderAmount",
            "in": "query",
            "required": false,
            "description": "传入时只返回使用门槛不高于该金额的优惠券",
            "schema": {"type": "number", "format": "double", "minimum": 0, "multipleOf": 0.01}
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserCouponListApiResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ActivityId": {
        "name": "activityId",
        "in": "path",
        "required": true,
        "schema": {"type": "integer", "format": "int64", "minimum": 1}
      },
      "VenueId": {
        "name": "venueId",
        "in": "path",
        "required": true,
        "schema": {"type": "integer", "format": "int64", "minimum": 1}
      },
      "RequestId": {
        "name": "requestId",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "maxLength": 64},
        "example": "CP20260810000001"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {"type": "integer", "minimum": 1, "default": 1}
      },
      "Size": {
        "name": "size",
        "in": "query",
        "required": false,
        "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
      },
      "ActivityStatusQuery": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {"$ref": "#/components/schemas/CouponActivityStatus"}
      }
    },
    "schemas": {
      "CouponActivityStatus": {
        "type": "string",
        "enum": ["DRAFT", "PUBLISHED", "ENDED", "CANCELLED"]
      },
      "UserCouponStatus": {
        "type": "string",
        "enum": ["AVAILABLE", "LOCKED", "USED", "EXPIRED"]
      },
      "CouponClaimStatus": {
        "type": "string",
        "enum": ["PENDING", "SUCCESS", "FAILED"]
      },
      "CouponClaimDisplayState": {
        "type": "string",
        "enum": ["NOT_STARTED", "IN_PROGRESS", "SOLD_OUT"]
      },
      "CouponActivityWriteRequest": {
        "type": "object",
        "required": [
          "name", "thresholdAmount", "discountAmount", "totalStock",
          "claimStartAt", "claimEndAt", "validFrom", "validUntil"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "thresholdAmount": {
            "type": "number", "format": "double", "minimum": 0, "multipleOf": 0.01,
            "description": "订单优惠前金额门槛"
          },
          "discountAmount": {
            "type": "number", "format": "double", "exclusiveMinimum": true, "minimum": 0, "multipleOf": 0.01
          },
          "totalStock": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "claimStartAt": {"type": "string", "format": "date-time"},
          "claimEndAt": {"type": "string", "format": "date-time"},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"}
        }
      },
      "CouponActivitySummary": {
        "type": "object",
        "required": [
          "id", "name", "thresholdAmount", "discountAmount", "totalStock",
          "remainingStock", "claimStartAt", "claimEndAt", "validFrom",
          "validUntil", "status", "cacheReady", "createdAt"
        ],
        "properties": {
          "id": {"type": "integer", "format": "int64", "example": 1001},
          "name": {"type": "string", "example": "暑期满100减20券"},
          "thresholdAmount": {"type": "number", "format": "double", "example": 100.00},
          "discountAmount": {"type": "number", "format": "double", "example": 20.00},
          "totalStock": {"type": "integer", "example": 500},
          "remainingStock": {"type": "integer", "example": 320},
          "claimStartAt": {"type": "string", "format": "date-time"},
          "claimEndAt": {"type": "string", "format": "date-time"},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"},
          "status": {"$ref": "#/components/schemas/CouponActivityStatus"},
          "cacheReady": {
            "type": "boolean",
            "description": "Redis 领取数据是否已经完成预热"
          },
          "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "CouponActivityDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/CouponActivitySummary"},
          {
            "type": "object",
            "required": ["venueId", "updatedAt"],
            "properties": {
              "venueId": {"type": "integer", "format": "int64", "example": 10},
              "preheatedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "最近一次成功预热时间"
              },
              "updatedAt": {"type": "string", "format": "date-time"}
            }
          }
        ]
      },
      "CouponActivityCreated": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "integer", "format": "int64", "example": 1001},
          "status": {"$ref": "#/components/schemas/CouponActivityStatus"}
        }
      },
      "CouponActivityPage": {
        "type": "object",
        "required": ["items", "total", "page", "size"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/CouponActivitySummary"}},
          "total": {"type": "integer", "format": "int64", "minimum": 0},
          "page": {"type": "integer", "minimum": 1},
          "size": {"type": "integer", "minimum": 1}
        }
      },
      "CatalogCouponActivity": {
        "type": "object",
        "required": [
          "id", "venueId", "name", "thresholdAmount", "discountAmount",
          "claimStartAt", "claimEndAt", "validFrom", "validUntil", "claimState"
        ],
        "properties": {
          "id": {"type": "integer", "format": "int64", "example": 1001},
          "venueId": {"type": "integer", "format": "int64", "example": 10},
          "name": {"type": "string", "example": "暑期满100减20券"},
          "thresholdAmount": {"type": "number", "format": "double", "example": 100.00},
          "discountAmount": {"type": "number", "format": "double", "example": 20.00},
          "claimStartAt": {"type": "string", "format": "date-time"},
          "claimEndAt": {"type": "string", "format": "date-time"},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"},
          "claimState": {"$ref": "#/components/schemas/CouponClaimDisplayState"}
        }
      },
      "ClaimAccepted": {
        "type": "object",
        "required": ["requestId", "status"],
        "properties": {
          "requestId": {"type": "string", "example": "CP20260810000001"},
          "status": {"$ref": "#/components/schemas/CouponClaimStatus"}
        }
      },
      "ClaimResult": {
        "type": "object",
        "required": ["requestId", "activityId", "status"],
        "properties": {
          "requestId": {"type": "string", "example": "CP20260810000001"},
          "activityId": {"type": "integer", "format": "int64", "example": 1001},
          "status": {"$ref": "#/components/schemas/CouponClaimStatus"},
          "userCouponId": {
            "type": "integer", "format": "int64", "nullable": true,
            "description": "仅 SUCCESS 时返回"
          },
          "failureReason": {
            "type": "string", "nullable": true,
            "enum": ["SOLD_OUT", "ALREADY_CLAIMED", "ACTIVITY_UNAVAILABLE"],
            "description": "仅 FAILED 时返回"
          },
          "processedAt": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "UserCoupon": {
        "type": "object",
        "required": [
          "id", "activityId", "venueId", "venueName", "couponName",
          "thresholdAmount", "discountAmount", "validFrom", "validUntil",
          "status", "acquiredAt"
        ],
        "properties": {
          "id": {"type": "integer", "format": "int64", "example": 2001},
          "activityId": {"type": "integer", "format": "int64", "example": 1001},
          "venueId": {"type": "integer", "format": "int64", "example": 10},
          "venueName": {"type": "string", "example": "海湾科技馆"},
          "couponName": {"type": "string", "example": "暑期满100减20券"},
          "thresholdAmount": {"type": "number", "format": "double", "example": 100.00},
          "discountAmount": {"type": "number", "format": "double", "example": 20.00},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"},
          "status": {"$ref": "#/components/schemas/UserCouponStatus"},
          "acquiredAt": {"type": "string", "format": "date-time"}
        }
      },
      "OperationResult": {
        "type": "object",
        "required": ["success"],
        "properties": {"success": {"type": "boolean", "example": true}}
      },
      "CouponActivityPageApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/CouponActivityPage"}}}
        ]
      },
      "CouponActivityCreatedApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/CouponActivityCreated"}}}
        ]
      },
      "CouponActivityDetailApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/CouponActivityDetail"}}}
        ]
      },
      "CatalogCouponActivityListApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/CatalogCouponActivity"}}}}
        ]
      },
      "ClaimAcceptedApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/ClaimAccepted"}}}
        ]
      },
      "ClaimResultApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/ClaimResult"}}}
        ]
      },
      "UserCouponListApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/UserCoupon"}}}}
        ]
      },
      "OperationApiResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/BaseApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/OperationResult"}}}
        ]
      },
      "BaseApiResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "example": "SUCCESS"},
          "message": {"type": "string", "example": "操作成功"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "example": "CONFLICT"},
          "message": {"type": "string", "example": "当前状态不允许执行该操作"},
          "data": {"type": "object", "nullable": true}
        }
      }
    },
    "responses": {
      "OperationSucceeded": {
        "description": "操作成功",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/OperationApiResponse"}}
        }
      },
      "InvalidRequest": {
        "description": "请求参数或业务时间范围不合法",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "Unauthorized": {
        "description": "未登录或令牌无效",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "Forbidden": {
        "description": "当前角色无权访问",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "ActivityNotFound": {
        "description": "活动不存在或不属于当前景点",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "VenueNotFound": {
        "description": "景点不存在或未启用",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "ClaimRequestNotFound": {
